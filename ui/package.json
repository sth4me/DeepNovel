{
  "name": "@sth4me/deepnovel-ui",
  "version": "0.1.44",
  "private": true,
  "type": "module",
  "description": "DeepNovel 写作台 UI（由主 bundle 自动安装，作为可选组件行）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
